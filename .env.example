# Klucz do Claude API - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model uzywany do ukladania przepisu (opus = najlepsza jakosc, sonnet = taniej)
RECIPES_MODEL=claude-opus-5

# Dostawca transkrypcji audio: local | none
#   local - faster-whisper na Twoim komputerze, za darmo (wymaga ffmpeg)
#   none  - bez transkrypcji, tylko opis posta + klatki wideo
RECIPES_TRANSCRIBER=local

# Rozmiar modelu Whisper: tiny | base | small | medium | large-v3
RECIPES_WHISPER_MODEL=small

# Ile klatek z wideo wyslac do Claude jako podglad (0 = wylacz)
RECIPES_FRAME_COUNT=6

# Katalog na cache (wideo, audio, klatki) i baze danych
RECIPES_DATA_DIR=./data
